PORT=3001
ENV_CHECK=1
TZ=Asia/Tashkent

# JWT sozlamalari (production uchun albatta o'zgartiring!)
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret
accessTokenExpiry=15m
refreshTokenExpiry=7d
QR_CODE_SECRET=change_me_qr_secret
# QR kodning amal qilish muddati (soniya)
QR_CODE_TTL=300

# CORS uchun ruxsat etilgan frontend manzillari (vergul bilan)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Database sozlamalari
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_NAME=Attendence
# Ilova ishga tushganda migratsiyalarni avtomatik yurgizish
DB_MIGRATIONS_RUN=true
